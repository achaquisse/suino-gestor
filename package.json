{
  "name": "suino-gestor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "gen:types": "node scripts/gen-types.mjs",
    "admin:sync": "node scripts/sync-super-admin.mjs",
    "test:sql": "node scripts/validate-sql.mjs",
    "typecheck": "tsc -b",
    "db:start": "supabase start && npm run admin:sync",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset && npm run admin:sync",
    "db:lint": "supabase db lint --level warning",
    "test:e2e": "codeceptjs run --config e2e/codecept.conf.js --steps",
    "test:e2e:core": "codeceptjs run --config e2e/codecept.conf.js --grep @future --invert --steps",
    "test:e2e:smoke": "codeceptjs run --config e2e/codecept.conf.js --grep @smoke --steps"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/query-async-storage-persister": "^5.105.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-persist-client": "^5.105.0",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@electric-sql/pglite": "^0.5.13",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "codeceptjs": "^4.2.5",
    "oxlint": "^1.89.0",
    "playwright": "^1.65.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
