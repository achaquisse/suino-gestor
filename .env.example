VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=... 
